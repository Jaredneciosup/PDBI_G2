void processCommand(String command, const char* source) {
  command.trim();
  if (command.isEmpty()) return;
  Serial.printf("RX <- %s: %s\n", source, command.c_str());

  if (command == "STATUS" || command == "?") {
    printStatus();
    return;
  }
  if (command == "BME:READ" || command == "BMP:READ") {
    if (captureState != CaptureState::IDLE) Serial.println("# BME ocupado en captura; ver STATUS");
    else refreshAmbient(true);
    return;
  }
  if (command == "CSV:INFO") {
    if (captureState == CaptureState::IDLE) notifyCsvFrame(0xFFFF);
    else Serial.println("# CSV:INFO disponible al terminar la captura");
    return;
  }
  if (command == "CSV:GET") {
    if (captureState != CaptureState::IDLE || csvCount == 0 || !deviceConnected) {
      Serial.println("# CSV:GET requiere captura terminada y cliente BLE conectado");
      return;
    }
    csvTransferIndex = 0;
    csvLastSendMs = millis();
    notifyCsvFrame(0xFFFF);
    csvTransferActive = true;
    Serial.printf("# CSV:GET transfiriendo %u filas de 20 B\n", unsigned(csvCount));
    return;
  }
  if (command.startsWith("CSV:ROW:")) {
    const String arg = command.substring(8);
    const int idx = arg.toInt();
    if (captureState == CaptureState::IDLE && !csvTransferActive && idx >= 0 &&
        idx < int(csvCount) && arg == String(idx)) notifyCsvFrame(uint16_t(idx));
    return;
  }
  if (command == "CSV:STOP") {
    csvTransferActive = false;
    return;
  }
  if (command == "CSV:DUMP") {
    if (captureState == CaptureState::IDLE && csvCount > 0) printCsv();
    return;
  }
  if (command == "TEST:LED" || command == "TEST:BUZZER" || command == "TEST:ALL") {
    const bool wantsLed = command != "TEST:BUZZER";
    const bool wantsBuzzer = command != "TEST:LED";
    if (wantsLed) {
      if (ENABLE_RGB_LED) {
        ledTestStartedMs = millis();
        ledTestActive = true;
        Serial.println("# TEST:LED iniciado (rojo, verde, azul, amarillo; 600 ms cada uno)");
      } else {
        Serial.println("# TEST:LED no iniciado: RGB deshabilitado. Conectar y poner ENABLE_RGB_LED=true");
      }
    }
    if (wantsBuzzer) {
      if (ENABLE_BUZZER) {
        buzzerTestStartedMs = millis();
        buzzerTestActive = true;
        Serial.println("# TEST:BUZZER iniciado (3 pulsos cortos; buzzer ACTIVO)");
      } else {
        Serial.println("# TEST:BUZZER no iniciado: deshabilitado. Conectar y poner ENABLE_BUZZER=true");
      }
    }
    return;
  }
  if (command == "TEST:OFF") {
    ledTestActive = false;
    buzzerTestActive = false;
    feedback = FeedbackType::IDLE;
    feedbackSinceMs = millis();
    if (ENABLE_RGB_LED) setRgb(false, false, false);
    if (ENABLE_BUZZER) digitalWrite(BUZZER_PIN, !BUZZER_ON_LEVEL);
    Serial.println("# TEST:OFF, actuadores apagados y feedback IDLE");
    return;
  }
  if (command == "MODE:DEMO" || command == "MODE:REAL") {
    if (captureState != CaptureState::IDLE) {
      Serial.println("# ERROR: primero terminar captura (S o STOP)");
      return;
    }
    runningDemo = false;
    dataMode = command == "MODE:DEMO" ? DataMode::DEMO : DataMode::REAL;
    updateModeCharacteristic();
    Serial.println(dataMode == DataMode::DEMO ?
      "# MODO DEMO: muestras sinteticas, NO pacientes" :
      "# MODO REAL: muestras del ABP2, NO sustituye calibracion");
    return;
  }
  if (command == "t" || command == "T" || command == "TARE") {
    startTare(false);
    return;
  }
  if (command == "m" || command == "M") {
    if (dataMode != DataMode::REAL) {
      Serial.println("# Activar MODE:REAL para medir con ABP2.");
      return;
    }
    if (!tareReady) {
      Serial.println("# Primero t y esperar TARA TERMINADA.");
      return;
    }
    startRealCapture(true);
    return;
  }
  if (command == "S" || command == "s" || command == "STOP") {
    runningDemo = false;
    if (captureState == CaptureState::MEASURING) finishRealCapture("detenida por usuario");
    else if (captureState == CaptureState::TARING) {
      captureState = CaptureState::IDLE;
      conversionPending = false;
      startAfterTare = false;
      tareReady = false;
      Serial.println("# Tara cancelada");
    }
    return;
  }
  if (command.startsWith("START:")) {
    String option = command.substring(6);
    if      (option == "NORMAL") scenario = NORMAL;
    else if (option == "SLOW") scenario = SLOW;
    else if (option == "COUGH") scenario = COUGH;
    else if (option == "EARLY") scenario = EARLY;
    else { Serial.println("# START desconocido"); return; }
    if (dataMode == DataMode::DEMO) {
      if (captureState != CaptureState::IDLE) {
        Serial.println("# ERROR: captura REAL activa"); return;
      }
      runningDemo = false;
      sampleIndex = 0;
      lastDemoPacketMs = millis();
      runningDemo = true;
      Serial.printf("# DEMO iniciada: %s\n", option.c_str());
    } else {
      if (captureState != CaptureState::IDLE) {
        Serial.println("# ERROR: captura en curso"); return;
      }
      // Flutter no envia t: se calibra automaticamente si aun no hay tara.
      Serial.println("# START REAL: nueva lectura BME + tara 1 s (NO soplar)");
      startTare(true);
    }
    return;
  }
  // Se conserva compatibilidad de eventos semanticos/color con Flutter.
  FeedbackType next = FeedbackType::IDLE;
  bool recognized = true;
  if (command.startsWith("LED:")) {
    String color = command.substring(4);
    if      (color == "GREEN") next = FeedbackType::GOOD_CONTINUE;
    else if (color == "YELLOW") next = FeedbackType::KEEP_BLOWING;
    else if (color == "RED") next = FeedbackType::INVALID;
    else if (color == "BLUE") next = FeedbackType::READY;
    else if (color == "OFF" || color == "NONE") next = FeedbackType::IDLE;
    else recognized = false;
  } else if (command.startsWith("FB:")) {
    String ev = command.substring(3);
    if      (ev == "IDLE") next = FeedbackType::IDLE;
    else if (ev == "READY") next = FeedbackType::READY;
    else if (ev == "BLOW_HARD") next = FeedbackType::BLOW_HARD;
    else if (ev == "KEEP_BLOWING") next = FeedbackType::KEEP_BLOWING;
    else if (ev == "GOOD_CONTINUE") next = FeedbackType::GOOD_CONTINUE;
    else if (ev == "SLOW_START") next = FeedbackType::SLOW_START;
    else if (ev == "COUGH") next = FeedbackType::COUGH;
    else if (ev == "EARLY_STOP") next = FeedbackType::EARLY_STOP;
    else if (ev == "ACCEPTABLE") next = FeedbackType::ACCEPTABLE;
    else if (ev == "INVALID") next = FeedbackType::INVALID;
    else recognized = false;
  } else recognized = false;
  if (recognized && feedback != next) {
    feedback = next;
    feedbackSinceMs = millis();
  }
  if (!recognized) Serial.println("# Comando no reconocido");
}

char serialBuffer[80] = {0};
uint8_t serialLen = 0;
void serviceSerial() {
  while (Serial.available()) {
    char c = char(Serial.read());
    if (c == '\r' || c == '\n') {
      if (serialLen) {
        serialBuffer[serialLen] = '\0';
        processCommand(String(serialBuffer), "SERIAL");
        serialLen = 0;
      }
    } else if (serialLen < sizeof(serialBuffer) - 1) {
      serialBuffer[serialLen++] = c;
    } else {
      serialLen = 0;
      Serial.println("# ERROR: comando serial demasiado largo");
    }
  }
}

void serviceBleCommands() {
  if (!bleCommands) return;
  BleCommand message;
  // Se evita atascar la adquisicion a 150 Hz si hay muchos eventos FB.
  uint8_t processed = 0;
  while (processed < 4 && xQueueReceive(bleCommands, &message, 0) == pdTRUE) {
    processCommand(String(message.text), "CELULAR");
    ++processed;
  }
}

void setup() {
  Serial.begin(115200);
  Serial.setTimeout(20);
  if (ENABLE_RGB_LED) {
    digitalWrite(LED_R, ANODO_COMUN ? HIGH : LOW);
    digitalWrite(LED_G, ANODO_COMUN ? HIGH : LOW);
    digitalWrite(LED_B, ANODO_COMUN ? HIGH : LOW);
    pinMode(LED_R, OUTPUT);
    pinMode(LED_G, OUTPUT);
    pinMode(LED_B, OUTPUT);
  }
  if (ENABLE_BUZZER) {
    digitalWrite(BUZZER_PIN, !BUZZER_ON_LEVEL);
    pinMode(BUZZER_PIN, OUTPUT);
  }
  pinMode(ABP_EOC_PIN, INPUT);
  feedback = FeedbackType::IDLE;
  feedbackSinceMs = millis();
  updateLed();
  updateBuzzer();
  delay(500);
  // Sin autoprueba bloqueante al arrancar: probar bajo demanda con TEST:LED/BUZZER.
  // hardwareSelfTest(); // opcional, solo tras verificar cableado
  initSensors();

  bleCommands = xQueueCreate(16, sizeof(BleCommand));
  if (!bleCommands) Serial.println("# ERROR: sin memoria para cola BLE");
  BLEDevice::init("EspiroGuia-ESP32");
  server = BLEDevice::createServer();
  server->setCallbacks(new ServerCallbacks());
  BLEService* service = server->createService(SERVICE_UUID);
  samplesChar = service->createCharacteristic(SAMPLES_UUID,
      BLECharacteristic::PROPERTY_NOTIFY);
  samplesChar->addDescriptor(new BLE2902());
  BLECharacteristic* commandChar = service->createCharacteristic(COMMAND_UUID,
      BLECharacteristic::PROPERTY_WRITE);
  commandChar->setCallbacks(new CommandCallbacks());
  telemetryChar = service->createCharacteristic(TELEMETRY_UUID,
      BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);
  telemetryChar->addDescriptor(new BLE2902());
  sensorsChar = service->createCharacteristic(SENSORS_UUID,
      BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);
  sensorsChar->addDescriptor(new BLE2902());
  modeChar = service->createCharacteristic(MODE_UUID,
      BLECharacteristic::PROPERTY_READ);
  csvDataChar = service->createCharacteristic(CSV_DATA_UUID,
      BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);
  csvDataChar->addDescriptor(new BLE2902());
  uint8_t initialCsvFrame[20] = {0};
  csvDataChar->setValue(initialCsvFrame, sizeof(initialCsvFrame));
  updateModeCharacteristic();  // 0=REAL, 1=DEMO
  uint8_t initialSensorPacket[14] = {0};
  initialSensorPacket[0] = 1;
  sensorsChar->setValue(initialSensorPacket, sizeof(initialSensorPacket));
  service->start();
  BLEAdvertising* advertising = BLEDevice::getAdvertising();
  advertising->addServiceUUID(SERVICE_UUID);
  advertising->setScanResponse(true);
  BLEDevice::startAdvertising();

  Serial.println("=== EspiroGuia ABP2/BME280 + BLE/CSV | PRUEBA 150 Hz ===");
  Serial.printf("OBJETIVO: %.2f Hz | PERIODO: %lu us | buffer CSV: %u filas\n",
                1000000.0 / SAMPLE_PERIOD_US,
                (unsigned long)SAMPLE_PERIOD_US, (unsigned)MAX_SERIAL_SAMPLES);
  Serial.printf("I2C SDA=GPIO%u SCL=GPIO%u, ABP2=0x28, EOC=GPIO%u (%s)\n",
      I2C_SDA_PIN, I2C_SCL_PIN, ABP_EOC_PIN,
      USE_ABP_EOC ? "habilitado" : "deshabilitado");
  Serial.printf("RGB externo=%s | buzzer externo=%s\n",
      ENABLE_RGB_LED ? "habilitado" : "deshabilitado",
      ENABLE_BUZZER ? "habilitado" : "deshabilitado");
  Serial.println("MODO REAL por defecto; NO se inventa flujo si faltan sensores.");
  Serial.println("SERIAL: t / m / S / STATUS / CSV:DUMP / BME:READ");
  Serial.println("BLE: START:NORMAL / STOP / CSV:GET / CSV:ROW:n / CSV:INFO");
  Serial.println("PRUEBAS: TEST:LED / TEST:BUZZER / TEST:ALL / TEST:OFF");
  Serial.println("BLE: START:NORMAL y STOP; FB:... mantiene LED+buzzer.");
  Serial.println("ATENCION: ventilacion / calibracion experimental, no uso clinico.");
  // No medir BME280 ni hacer tara durante el arranque: se realiza
  // una vez antes de cada maniobra (START por BLE o t por Serial).
}

void loop() {
  serviceSerial();
  serviceBleCommands();
  if (disconnectPending) {
    csvTransferActive = false;
    disconnectPending = false;
    runningDemo = false;
    if (captureState == CaptureState::MEASURING && !csvRequested)
      finishRealCapture("BLE desconectado");
    if (captureState == CaptureState::TARING && startAfterTare) {
      captureState = CaptureState::IDLE;
      conversionPending = false;
      startAfterTare = false;
    }
  }
  static bool hadClient = false;
  if (!deviceConnected && hadClient) {
    server->startAdvertising();
    hadClient = false;
  }
  if (deviceConnected) hadClient = true;

  serviceCapture(); // 150 Hz objetivo; comprobar Hz reales en el CSV
  serviceCsvTransfer(); // transmision BLE en reposo, no durante la adquisicion
  const uint32_t now = millis();
  if (runningDemo && deviceConnected &&
      (uint32_t)(now - lastDemoPacketMs) >= 100) {
    lastDemoPacketMs = now;
    sendSyntheticSamples();
  }
  if (deviceConnected && (uint32_t)(now - lastTelemetryMs) >= 1000) {
    lastTelemetryMs = now;
    sendTelemetry();
  }
  if (captureState == CaptureState::IDLE && abpDetected &&
      (uint32_t)(now - lastIdleAbpMs) >= 100) {
    lastIdleAbpMs = now;
    refreshIdleAbp();
  }
  if (captureState == CaptureState::IDLE && !abpDetected &&
      (uint32_t)(now - lastAbpProbeMs) >= 3000) probeAbp();
  const uint32_t sensorInterval =
      captureState == CaptureState::MEASURING ? SENSOR_BLE_LIVE_INTERVAL_MS
                                              : SENSOR_BLE_INTERVAL_MS;
  if (deviceConnected &&
      (uint32_t)(now - lastSensorBleMs) >= sensorInterval) {
    lastSensorBleMs = now;
    publishSensorReadings();
  }
  updateLed();
  updateBuzzer();
  // Temporizacion adaptable: en captura se reduce la latencia de sondeo.
  // Sigue cediendo el procesador durante la mayor parte de la conversion.
  if (captureState == CaptureState::IDLE) {
    delay(1);
  } else if (conversionPending) {
    const uint32_t ageUs = (uint32_t)(micros() - abpCommandSentUs);
    if (ageUs < 3200UL) delay(1);
    else delayMicroseconds(120);
  } else {
    const int32_t untilNextUs = (int32_t)(nextSampleUs - micros());
    if (untilNextUs > 1800) delay(1);
    else delayMicroseconds(120);
  }
}
