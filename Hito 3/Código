void probeAbp() {
  lastAbpProbeMs = millis();
  Wire.beginTransmission(ABP_I2C_ADDRESS);
  bool detected = Wire.endTransmission() == 0;
  if (detected != abpDetected) {
    Serial.println(detected ? "ABP2 detectado en 0x28" : "ABP2 sin respuesta en 0x28");
  }
  abpDetected = detected;
  if (detected) abpFailures = 0;
  else { lastAbpValidMs = 0; tareReady = false; }
}

void initSensors() {
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  Wire.setClock(100000);
  Wire.setTimeOut(10);
  bmeAvailable = bme.begin(0x76, &Wire);
  if (!bmeAvailable) bmeAvailable = bme.begin(0x77, &Wire);
  if (bmeAvailable) {
    bme.setSampling(Adafruit_BME280::MODE_FORCED,
                    Adafruit_BME280::SAMPLING_X1,
                    Adafruit_BME280::SAMPLING_X1,
                    Adafruit_BME280::SAMPLING_X1,
                    Adafruit_BME280::FILTER_OFF,
                    Adafruit_BME280::STANDBY_MS_1000);
    Serial.println("BME280 detectado");
  } else {
    Serial.println("BME280 NO detectado; comprobar 0x76/0x77 y cableado.");
  }
  probeAbp();
}

bool refreshAmbient(bool verbose = false) {
  if (!bmeAvailable) return false;
  if (!bme.takeForcedMeasurement()) return false;
  double temperature = bme.readTemperature();
  double pressure = bme.readPressure();
  double humidity = bme.readHumidity();
  if (!isfinite(temperature) || !isfinite(pressure) || !isfinite(humidity) ||
      pressure <= 0 || humidity < 0 || humidity > 100 || temperature < -40 ||
      temperature > 85) {
    if (verbose) Serial.println("BME280 lectura invalida");
    return false;
  }
  ambientTemperatureC = (float)temperature;
  ambientPressurePa = (float)pressure;
  ambientHumidityPct = (float)humidity;
  lastAmbientValidMs = millis();
  if (verbose) {
    Serial.printf("BME280 T=%.2f C, P=%.2f hPa, HR=%.1f %%\n",
                  temperature, pressure / 100.0, humidity);
  }
  return true;
}

// Honeywell ABP2: el comando inicia la conversion. Se completa de forma
// NO BLOQUEANTE en serviceCapture() tras esperar >=5 ms o BUSY=0.
bool beginAbpConversion(uint32_t nowUs) {
  Wire.beginTransmission(ABP_I2C_ADDRESS);
  Wire.write(0xAA);
  Wire.write(0x00);
  Wire.write(0x00);
  if (Wire.endTransmission() != 0) return false;
  abpCommandSentUs = nowUs;
  conversionPending = true;
  return true;
}

// Entrega true solo para una lectura NUEVA ya lista y valida.
// Si BUSY sigue a 1, se reintentara sin bloquear la ejecucion.
// Declaracion explicita: evita que Arduino genere un prototipo
// antes de conocer AbpReadStatus (error en IDE).
enum class AbpReadStatus : uint8_t { WAITING, GOOD, ERROR };
AbpReadStatus finishAbpConversion(double& pressurePa, double& temperatureC);

AbpReadStatus finishAbpConversion(double& pressurePa, double& temperatureC) {
  uint32_t elapsed = (uint32_t)(micros() - abpCommandSentUs);
  if (elapsed < 5000UL) return AbpReadStatus::WAITING;
  // Honeywell ABP2 (modo sleep): EOC pasa de LOW a HIGH cuando termina
  // la conversion. Si el EOC no esta conectado, desactivar USE_ABP_EOC.
  if (USE_ABP_EOC && digitalRead(ABP_EOC_PIN) == LOW) {
    return (elapsed >= 9500UL) ? AbpReadStatus::ERROR : AbpReadStatus::WAITING;
  }
  uint8_t bytes[7];
  if (Wire.requestFrom(ABP_I2C_ADDRESS, (uint8_t)7) != 7) {
    while (Wire.available()) Wire.read();
    return AbpReadStatus::ERROR;
  }
  for (uint8_t i = 0; i < 7; ++i) bytes[i] = Wire.read();
  const uint8_t status = bytes[0];
  // Bit 6=encendido, bit 5=busy, bit 2=error, bit 0=saturacion.
  if ((status & 0x40) == 0 || (status & 0x05) != 0) return AbpReadStatus::ERROR;
  if ((status & 0x20) != 0) {
    return (elapsed >= 9500UL) ? AbpReadStatus::ERROR : AbpReadStatus::WAITING;
  }
  const uint32_t pc = (uint32_t(bytes[1]) << 16) |
                      (uint32_t(bytes[2]) << 8) | uint32_t(bytes[3]);
  const uint32_t tc = (uint32_t(bytes[4]) << 16) |
                      (uint32_t(bytes[5]) << 8) | uint32_t(bytes[6]);
  if (pc <= ABP_COUNTS_MIN || pc >= ABP_COUNTS_MAX) return AbpReadStatus::ERROR;
  pressurePa = ((double(pc) - ABP_COUNTS_MIN) * 4.0 /
                (ABP_COUNTS_MAX - ABP_COUNTS_MIN) - 2.0) * ABP_PA_PER_INH2O;
  temperatureC = double(tc) * 200.0 / 16777215.0 - 50.0;
  if (!isfinite(pressurePa) || !isfinite(temperatureC)) return AbpReadStatus::ERROR;
  abpDifferentialPa = float(pressurePa);
  abpTemperatureC = float(temperatureC);
  lastAbpValidMs = millis();
  abpFailures = 0;
  return AbpReadStatus::GOOD;
}

// Al estar inactivo se conserva la telemetria real de presion del firmware
// original (~10 Hz). Solo esta rutina de diagnostico puede esperar 5 ms;
// durante las capturas la adquisicion sigue siendo NO BLOQUEANTE.
void refreshIdleAbp() {
  if (captureState != CaptureState::IDLE || !abpDetected) return;
  const uint32_t beginUs = micros();
  if (!beginAbpConversion(beginUs)) {
    if (++abpFailures >= 15) {
      abpDetected = false;
      lastAbpValidMs = 0;
      tareReady = false;
    }
    return;
  }
  double dp = NAN, temp = NAN;
  bool gotSample = false;
  while ((uint32_t)(micros() - beginUs) < 9500UL) {
    const AbpReadStatus result = finishAbpConversion(dp, temp);
    if (result == AbpReadStatus::GOOD) { gotSample = true; break; }
    if (result == AbpReadStatus::ERROR) break;
    delayMicroseconds(150);
  }
  conversionPending = false;
  if (!gotSample && ++abpFailures >= 15) {
    abpDetected = false;
    lastAbpValidMs = 0;
    tareReady = false;
    Serial.println("# ABP2: perdida la comunicacion en reposo");
  }
}

void publishSensorReadings() {
  if (!deviceConnected || sensorsChar == nullptr) return;
  uint32_t now = millis();
  const bool ambientOk = bmeAvailable && lastAmbientValidMs != 0 &&
      isfinite(ambientTemperatureC) && isfinite(ambientPressurePa);
  const bool inManeuver = captureState == CaptureState::MEASURING;
  const float pressureToSend = inManeuver ? abpLiveDifferentialPa : abpDifferentialPa;
  const bool abpOk = abpDetected && lastAbpValidMs != 0 &&
      (uint32_t)(now - lastAbpValidMs) < 800 && isfinite(pressureToSend);
  // Se conserva el paquete de 14 B de Flutter, aunque ahora el ambiente
  // procede de BME280 (los bits 0-1 denotan temperatura y P atmosferica).
  uint8_t packet[14] = {0};
  packet[0] = 1;
  // Bit 3 = maniobra REAL activa, con presion corregida por tara.
  // Fuera de la maniobra se mantienen el paquete y los flags anteriores.
  packet[1] = (ambientOk ? 0x03 : 0) | (abpOk ? 0x04 : 0) |
              ((inManeuver && abpOk) ? 0x08 : 0);
  put32le(packet + 2, now);
  if (ambientOk) {
    put16le(packet + 6, uint16_t(clamp16(lroundf(ambientTemperatureC * 100))));
    put32le(packet + 8, uint32_t(lroundf(ambientPressurePa)));
  }
  if (abpOk) {
    put16le(packet + 12, uint16_t(clamp16(lroundf(pressureToSend * 10))));
  }
  sensorsChar->setValue(packet, sizeof(packet));
  sensorsChar->notify();
}

