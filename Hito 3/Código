bool startTare(bool autoStartAfterTare) {
  if (captureState != CaptureState::IDLE || runningDemo) {
    Serial.println("# ERROR: terminar la medicion antes de tarear.");
    return false;
  }
  if (!abpDetected || !bmeAvailable) {
    Serial.println("# ERROR: se requieren ABP2 + BME280 para modo REAL.");
    tareReady = false;
    return false;
  }
  if (!refreshAmbient(true)) {
    Serial.println("# ERROR: no se pudo leer BME280 para la tara.");
    tareReady = false;
    return false;
  }
  // Densidad del aire HUMEDO como en el sketch de prueba.
  const double tK = double(ambientTemperatureC) + 273.15;
  const double pSat = 610.94 * exp(17.625 * ambientTemperatureC /
                                 (ambientTemperatureC + 243.04));
  const double pVapor = (ambientHumidityPct / 100.0) * pSat;
  double rho = (ambientPressurePa - pVapor) / (287.05 * tK) +
               pVapor / (461.5 * tK);
  if (!isfinite(rho) || rho <= 0 || rho > 3.0) {
    Serial.println("# ERROR: densidad de aire invalida.");
    tareReady = false;
    return false;
  }
  airDensityKgM3 = rho;
  tareReady = false;
  startAfterTare = autoStartAfterTare;
  tareSumPa = 0;
  tareSumTemp = 0;
  tareValidCount = 0;
  badReads = 0;
  missedPeriods = 0;
  conversionPending = false;
  stateStartedUs = micros();
  nextSampleUs = stateStartedUs;
  captureState = CaptureState::TARING;
  Serial.println("# TARA INICIADA: mantener el Venturi SIN FLUJO 1 segundo.");
  return true;
}

bool startRealCapture(bool printCsv) {
  if (captureState != CaptureState::IDLE || runningDemo) return false;
  if (dataMode != DataMode::REAL || !abpDetected || !bmeAvailable ||
      !tareReady || !isfinite(airDensityKgM3) || airDensityKgM3 <= 0) {
    Serial.println("# ERROR: faltan sensores o tara. Enviar t antes de m.");
    return false;
  }
  csvRequested = printCsv;
  csvTransferActive = false;
  csvOverflow = false;
  csvCount = 0;
  abpLiveDifferentialPa = NAN;
  firstRecordUs = 0;
  lastRecordUs = 0;
  lastMeasuredHz = 0;
  // START despues de completar la tara: 1 pitido = comenzar a soplar.
  cueSound(CueType::START);
  finishedLedSinceMs = 0;
  volumeL = 0;
  previousFlowLs = 0;
  lastFlowSampleUs = 0;
  validFlowSamples = 0;
  missedPeriods = 0;
  badReads = 0;
  blePacketCount = 0;
  bleDecimation = 0;
  conversionPending = false;
  stateStartedUs = micros();
  nextSampleUs = stateStartedUs;
  captureState = CaptureState::MEASURING;
  Serial.printf("# MEDICION REAL INICIADA | %s | limite=%u s\n",
    printCsv ? "CSV por SERIAL" : "flujo por BLE",
    unsigned(printCsv ? SERIAL_DURATION_US / 1000000UL : BLE_DURATION_US / 1000000UL));
  return true;
}

void printCsv() {
  Serial.println("# BEGIN");
  Serial.printf("# BME280_UNA_LECTURA: T=%.3f C, P=%.2f Pa, HR=%.2f %%\n",
                ambientTemperatureC, ambientPressurePa, ambientHumidityPct);
  Serial.printf("# FRECUENCIA_REAL_HZ=%.3f, MUESTRAS=%u, PERDIDAS=%u, ERRORES=%u\n",
                lastMeasuredHz, unsigned(csvCount), unsigned(missedPeriods), unsigned(badReads));
  Serial.println("tiempo_s,dp_Pa,flujo_Ls,volumen_L,temp_ABP_C");
  for (size_t i = 0; i < csvCount; ++i) {
    const FlowRecord& r = csvSamples[i];
    Serial.printf("%.6f,%.5f,%.6f,%.6f,%.3f\n",
      r.tiempoUs / 1000000.0, r.dpPa, r.flujoLs,
      r.volumenL, r.tempAbpC);
  }
  Serial.println("# END");
}

void finishRealCapture(const char* reason) {
  if (captureState != CaptureState::MEASURING) return;
  captureState = CaptureState::IDLE;
  conversionPending = false;
  // El formato BLE admite paquetes de 4 B por muestra. Al cerrar,
  // publicamos el lote parcial para no perder los ultimos puntos.
  if (!csvRequested && deviceConnected && samplesChar && blePacketCount > 0) {
    samplesChar->setValue(blePacket, blePacketCount * 4);
    samplesChar->notify();
  }
  blePacketCount = 0;
  if (csvCount > 1 && lastRecordUs > firstRecordUs) {
    lastMeasuredHz = float((csvCount - 1) * 1000000.0 /
                           double(lastRecordUs - firstRecordUs));
  }
  finishedLedSinceMs = millis();
  feedback = FeedbackType::IDLE;
  feedbackSinceMs = millis();
  cueSound(CueType::END);
  Serial.printf("# FRECUENCIA REAL=%.2f Hz (objetivo experimental=150) | registros=%u | overflow=%s\n",
                lastMeasuredHz, unsigned(csvCount), csvOverflow ? "SI" : "NO");
  if (lastMeasuredHz < 145.0f)
    Serial.println("# AVISO: tasa efectiva <145 Hz; revisar periodos perdidos, BLE e I2C.");
  Serial.printf("# MEDICION TERMINADA: %s | validas=%u | periodos_perdidos=%u | errores=%u\n",
    reason, unsigned(validFlowSamples), unsigned(missedPeriods), unsigned(badReads));
  if (csvRequested) {
    printCsv();
    Serial.println("# Listo: m para otra captura; t para nueva tara.");
  }
  csvRequested = false;
}

void finishTare() {
  if (captureState != CaptureState::TARING) return;
  captureState = CaptureState::IDLE;
  conversionPending = false;
  if (tareValidCount < 90) {
    tareReady = false;
    Serial.printf("# ERROR DE TARA: %u muestras validas (minimo 90). Repetir t.\n",
                  unsigned(tareValidCount));
    startAfterTare = false;
    cueSound(CueType::ERROR);
    return;
  }
  tareOffsetPa = tareSumPa / tareValidCount;
  tareReady = true;
  Serial.printf("# TARA TERMINADA: offset=%.4f Pa, T_ABP2=%.2f C, n=%u\n",
    tareOffsetPa, tareSumTemp / tareValidCount, unsigned(tareValidCount));
  Serial.printf("# Densidad=%.6f kg/m3 | BME T=%.2f C, P=%.2f hPa, HR=%.1f %%\n",
    airDensityKgM3, ambientTemperatureC, ambientPressurePa / 100.0,
    ambientHumidityPct);
  if (startAfterTare) {
    startAfterTare = false;
    startRealCapture(false);
  }
}

void pushBleSample(uint32_t sampleUs, double flowLs) {
  if (!deviceConnected || !samplesChar || csvRequested) return;
  // Decimacion 150 -> ~50 Hz para la vista BLE, sin alterar el CSV.
  // Evita enviar 75 Hz al celular, que pasaria con el divisor antiguo de 2.
  if (++bleDecimation < BLE_PREVIEW_DECIMATION) return;
  bleDecimation = 0;
  const uint32_t elapsedUs = (uint32_t)(sampleUs - stateStartedUs);
  const uint16_t centiseconds = uint16_t((elapsedUs + 5000UL) / 10000UL);
  const int16_t centilitersPerSec = clamp16(lround(flowLs * 100.0));
  const uint8_t i = blePacketCount;
  put16le(blePacket + i * 4, centiseconds);
  put16le(blePacket + i * 4 + 2, uint16_t(centilitersPerSec));
  ++blePacketCount;
  if (blePacketCount == BLE_SAMPLES_PER_PACKET) {
    samplesChar->setValue(blePacket, sizeof(blePacket));
    samplesChar->notify();
    blePacketCount = 0;
  }
}

void handleAbpSample(uint32_t sampleUs, double dpRawPa, double tempC) {
  if (captureState == CaptureState::TARING) {
    tareSumPa += dpRawPa;
    tareSumTemp += tempC;
    ++tareValidCount;
    return;
  }
  if (captureState != CaptureState::MEASURING) return;
  // Misma formulacion de prueba_sensor_de_presion_diferencial.ino.
  const double dp = SIGNO_PRESION * (dpRawPa - tareOffsetPa);
  double flow = COEF_DESCARGA * AREA_GARGANTA_M2 *
    sqrt(2.0 * fabs(dp) / (airDensityKgM3 * (1.0 - pow(BETA, 4)))) * 1000.0;
  if (dp < 0) flow = -flow;
  if (!isfinite(flow)) {
    ++badReads;
    return;
  }
  if (lastFlowSampleUs != 0) {
    const double dt = (uint32_t)(sampleUs - lastFlowSampleUs) / 1000000.0;
    volumeL += 0.5 * (previousFlowLs + flow) * dt;
  }
  lastFlowSampleUs = sampleUs;
  previousFlowLs = flow;
  ++validFlowSamples;
  // Guardar SIEMPRE las muestras originales, tanto al medir por BLE como por USB.
  if (csvCount < MAX_SERIAL_SAMPLES) {
    FlowRecord& record = csvSamples[csvCount++];
    record.tiempoUs = (uint32_t)(sampleUs - stateStartedUs);
    record.dpPa = float(dp);
    abpLiveDifferentialPa = record.dpPa; // solo muestras guardadas; misma tara que el CSV
    record.flujoLs = float(flow);
    record.volumenL = float(volumeL);
    record.tempAbpC = float(tempC);
    if (firstRecordUs == 0) firstRecordUs = sampleUs;
    lastRecordUs = sampleUs;
  } else csvOverflow = true;
  pushBleSample(sampleUs, flow);
}

// Una maquina de estados adquiere el ABP2 SIN delay(8) y deja al BLE,
// al LED y al buzzer tiempo para actualizarse.
void serviceCapture() {
  if (captureState == CaptureState::IDLE) return;
  uint32_t nowUs = micros();
  const uint32_t duration = (captureState == CaptureState::TARING) ?
    TARE_DURATION_US : (csvRequested ? SERIAL_DURATION_US : BLE_DURATION_US);
  if ((uint32_t)(nowUs - stateStartedUs) >= duration) {
    if (captureState == CaptureState::TARING) finishTare();
    else finishRealCapture("tiempo maximo");
    return;
  }

  if (conversionPending) {
    double pressurePa, tempC;
    const AbpReadStatus result = finishAbpConversion(pressurePa, tempC);
    if (result == AbpReadStatus::WAITING) return;
    conversionPending = false;
    if (result == AbpReadStatus::GOOD) {
      abpFailures = 0;
      handleAbpSample(micros(), pressurePa, tempC);
    } else {
      ++badReads;
      ++abpFailures;
      if (abpFailures >= 15) {
        Serial.println("# ERROR ABP2: 15 fallos consecutivos. Captura cancelada.");
        abpDetected = false;
        tareReady = false;
        if (captureState == CaptureState::TARING) {
          captureState = CaptureState::IDLE;
          startAfterTare = false;
        } else finishRealCapture("error ABP2 / posible saturacion");
        return;
      }
    }
  }

  nowUs = micros();
  if ((int32_t)(nowUs - nextSampleUs) < 0 || conversionPending) return;
  // Si el BLE/I2C demora, saltamos la ranura, SIN inventar una muestra.
  if ((uint32_t)(nowUs - nextSampleUs) >= SAMPLE_PERIOD_US) {
    ++missedPeriods;
    nextSampleUs = nowUs;
  }
  nextSampleUs += SAMPLE_PERIOD_US;
  if (!beginAbpConversion(micros())) {
    ++badReads;
    ++abpFailures;
    if (abpFailures >= 15) {
      Serial.println("# ERROR ABP2: sensor sin respuesta. Captura detenida.");
      abpDetected = false;
      tareReady = false;
      if (captureState == CaptureState::TARING) {
        captureState = CaptureState::IDLE;
        startAfterTare = false;
      } else finishRealCapture("sin respuesta I2C");
    }
  }
}

// Registro BLE 20 B LE: indice:uint16, t_us:uint32, dp:float32,
// flujo:float32, volumen:float32, tempABP_centiC:int16.
// 0xFFFF: t_us=numero_registros, dp=T_BME, flujo=P_BME_Pa, volumen=HR_BME,
//          temp_centi=periodo_objetivo_us.
// 0xFFFE: t_us=numero_registros, dp=Hz_real, flujo=periodos_perdidos,
//          volumen=lecturas_fallidas, temp_centi=1 si hubo desbordamiento.
void csvFrame(uint16_t index, uint8_t out[20]) {
  memset(out, 0, 20);
  put16le(out, index);
  if (index == 0xFFFF) {
    put32le(out + 2, uint32_t(csvCount));
    float vals[3] = {ambientTemperatureC, ambientPressurePa, ambientHumidityPct};
    memcpy(out + 6, vals, 12);
    put16le(out + 18, uint16_t(SAMPLE_PERIOD_US));
  } else if (index == 0xFFFE) {
    put32le(out + 2, uint32_t(csvCount));
    float vals[3] = {lastMeasuredHz, float(missedPeriods), float(badReads)};
    memcpy(out + 6, vals, 12);
    put16le(out + 18, csvOverflow ? 1 : 0);
  } else if (index < csvCount) {
    const FlowRecord &r = csvSamples[index];
    put32le(out + 2, r.tiempoUs);
    float vals[3] = {r.dpPa, r.flujoLs, r.volumenL};
    memcpy(out + 6, vals, 12);
    put16le(out + 18, uint16_t(clamp16(lroundf(r.tempAbpC * 100.0f))));
  }
}

void notifyCsvFrame(uint16_t index) {
  if (!deviceConnected || !csvDataChar) return;
  uint8_t frame[20];
  csvFrame(index, frame);
  csvDataChar->setValue(frame, sizeof(frame));
  csvDataChar->notify();
}

void serviceCsvTransfer() {
  if (!csvTransferActive) return;
  if (!deviceConnected || captureState != CaptureState::IDLE) {
    csvTransferActive = false;
    return;
  }
  if ((uint32_t)(millis() - csvLastSendMs) < CSV_SEND_INTERVAL_MS) return;
  csvLastSendMs = millis();
  if (csvTransferIndex < csvCount) {
    notifyCsvFrame(csvTransferIndex++);
  } else {
    notifyCsvFrame(0xFFFE); // FIN, reintentar filas ausentes con CSV:ROW:n
    csvTransferActive = false;
    Serial.println("# CSV BLE enviado (verificar indices en receptor)");
  }
}

