// Se conserva esta DEMO para las pruebas sin ESP32 conectado a un Venturi.
double syntheticFlow(double t) {
  if (t < 0 || t > 9) return 0;
  const DemoType kind = scenario;
  if (kind == EARLY && t >= 2.0) return 0;
  if (kind == COUGH && t >= 0.50 && t <= 0.72) return 0.05;
  const double rise = kind == SLOW ? 0.95 : 0.10;
  const double amplitude = kind == SLOW ? 4.4 : 4.8;
  return amplitude * (1.0 - exp(-t / rise)) * exp(-t / 1.16);
}

void sendSyntheticSamples() {
  if (!runningDemo || !deviceConnected || !samplesChar) return;
  uint8_t packet[BLE_SAMPLES_PER_PACKET * 4];
  for (uint8_t i = 0; i < BLE_SAMPLES_PER_PACKET; ++i) {
    const double t = sampleIndex * 0.020; // 50 Hz
    if (t >= 9.5) { runningDemo = false; return; }
    const int16_t flowCenti = clamp16(lround(syntheticFlow(t) * 100.0));
    const uint16_t tCenti = uint16_t(sampleIndex * 2);
    put16le(packet + 4 * i, tCenti);
    put16le(packet + 4 * i + 2, uint16_t(flowCenti));
    ++sampleIndex;
  }
  samplesChar->setValue(packet, sizeof(packet));
  samplesChar->notify();
}

