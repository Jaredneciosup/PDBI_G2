// En anodo comun: LOW en el GPIO enciende ese color, HIGH lo apaga.
// Cada canal necesita SU PROPIA resistencia (220-330 ohmios).
void setRgb(bool red, bool green, bool blue) {
  if (!ENABLE_RGB_LED) return;
  digitalWrite(LED_R, red   == ANODO_COMUN ? LOW : HIGH);
  digitalWrite(LED_G, green == ANODO_COMUN ? LOW : HIGH);
  digitalWrite(LED_B, blue  == ANODO_COMUN ? LOW : HIGH);
}

// Se ejecuta en cada iteracion, sin delay bloqueante ni pulsos desde Flutter.
// Los patrones continúan solos hasta recibir un nuevo FB:..., o desconectarse.
void updateLed() {
  if (!ENABLE_RGB_LED) return;
  // Prueba manual con prioridad sobre el feedback BLE. 4 colores x 600 ms.
  if (ledTestActive) {
    const uint32_t testElapsed = (uint32_t)(millis() - ledTestStartedMs);
    if (testElapsed < 2400UL) {
      switch (testElapsed / 600UL) {
        case 0: setRgb(true, false, false); break;   // rojo
        case 1: setRgb(false, true, false); break;   // verde
        case 2: setRgb(false, false, true); break;   // azul
        default: setRgb(true, true, false); break;  // amarillo
      }
      return;
    }
    ledTestActive = false;
    Serial.println("# TEST:LED terminado");
  }
  // Estado autonomo de captura; feedback Flutter se superpone solo en maniobra.
  if (captureState == CaptureState::TARING) {
    setRgb(false, false, (millis() % 600) < 250); // azul: no soplar
    return;
  }
  if (captureState == CaptureState::IDLE && finishedLedSinceMs &&
      (uint32_t)(millis() - finishedLedSinceMs) < 1500UL) {
    setRgb(false, true, false); // verde: captura completada
    return;
  }
  const uint32_t elapsed = millis() - feedbackSinceMs;
  const FeedbackType state = feedback;
  bool red = false;
  bool green = false;
  bool blue = false;

  switch (state) {
    case FeedbackType::IDLE: break; // apagado
    case FeedbackType::READY:
      blue = (elapsed % 1400) < 250; // destello azul lento
      break;
    case FeedbackType::BLOW_HARD:
      red = green = (elapsed % 360) < 180; // amarillo rapido
      break;
    case FeedbackType::KEEP_BLOWING:
      red = green = (elapsed % 1200) < 750; // amarillo pausado
      break;
    case FeedbackType::GOOD_CONTINUE:
      green = (elapsed % 900) < 700; // verde pulsante
      break;
    case FeedbackType::SLOW_START: {
      const uint32_t t = elapsed % 1250;
      red = green = (t < 130 || (t >= 260 && t < 390)); // doble amarillo
      break;
    }
    case FeedbackType::COUGH: {
      const uint32_t t = elapsed % 1400;
      red = t < 120 || (t >= 240 && t < 360) || (t >= 480 && t < 600);
      break; // triple rojo
    }
    case FeedbackType::EARLY_STOP:
      red = (elapsed % 350) < 120; // rojo rapido
      break;
    case FeedbackType::ACCEPTABLE:
      green = true; // verde constante
      break;
    case FeedbackType::INVALID:
      red = true; // rojo constante
      break;
  }
  if (captureState == CaptureState::MEASURING && state == FeedbackType::IDLE)
    green = true; // medicion activa, sin feedback de la app
  setRgb(red, green, blue);
}

// El zumbador NO sigue los parpadeos del LED. Cada evento crea un patron
// audible independiente calculado localmente por millis(); el telefono
// solo manda el significado del feedback (FB:...).
// Evitamos sonidos prolongados, especialmente en KEEP_BLOWING.
void updateBuzzer() {
  if (!ENABLE_BUZZER) return;
  // Tres pitidos cortos sin bloquear loop() ni mantener el zumbador encendido.
  // Solo para buzzer ACTIVO, cuya polaridad se define en BUZZER_ON_LEVEL.
  if (buzzerTestActive) {
    const uint32_t testElapsed = (uint32_t)(millis() - buzzerTestStartedMs);
    if (testElapsed < 1200UL) {
      const bool sound = (testElapsed % 400UL) < 120UL;
      digitalWrite(BUZZER_PIN, sound ? BUZZER_ON_LEVEL : !BUZZER_ON_LEVEL);
      return;
    }
    buzzerTestActive = false;
    Serial.println("# TEST:BUZZER terminado");
  }
  // Señal local de inicio/fin con prioridad sobre los mensajes recibidos por BLE.
  const uint32_t cueElapsed = (uint32_t)(millis() - cueSinceMs);
  if (cue != CueType::NONE) {
    bool tone = false;
    uint32_t durationMs = 0;
    if (cue == CueType::START) {
      durationMs = 180; tone = cueElapsed < 130;
    } else if (cue == CueType::END) {
      durationMs = 520;
      tone = cueElapsed < 120 || (cueElapsed >= 230 && cueElapsed < 350);
    } else {
      durationMs = 900;
      tone = cueElapsed < 130 || (cueElapsed >= 250 && cueElapsed < 380) ||
             (cueElapsed >= 500 && cueElapsed < 630);
    }
    if (cueElapsed < durationMs) {
      digitalWrite(BUZZER_PIN, tone ? BUZZER_ON_LEVEL : !BUZZER_ON_LEVEL);
      return;
    }
    cue = CueType::NONE;
  }
  if (captureState == CaptureState::TARING) {
    digitalWrite(BUZZER_PIN, !BUZZER_ON_LEVEL);
    return;
  }
  const uint32_t elapsed = millis() - feedbackSinceMs;
  const FeedbackType state = feedback;
  bool sound = false;
  switch (state) {
    case FeedbackType::IDLE:
      break;
    case FeedbackType::READY:
      sound = elapsed < 95; // aviso breve de preparado
      break;
    case FeedbackType::BLOW_HARD:
      sound = (elapsed < 95) || (elapsed >= 210 && elapsed < 305);
      break;
    case FeedbackType::KEEP_BLOWING:
      sound = (elapsed % 3500) < 95; // recordatorio muy breve cada 3.5 s
      break;
    case FeedbackType::GOOD_CONTINUE:
      sound = elapsed < 75; // confirmacion breve
      break;
    case FeedbackType::SLOW_START:
      sound = (elapsed < 120) || (elapsed >= 240 && elapsed < 360);
      break;
    case FeedbackType::COUGH:
      sound = (elapsed < 125) || (elapsed >= 250 && elapsed < 375) ||
              (elapsed >= 500 && elapsed < 625);
      break;
    case FeedbackType::EARLY_STOP:
      sound = (elapsed < 180) || (elapsed >= 340 && elapsed < 520);
      break;
    case FeedbackType::ACCEPTABLE:
      sound = (elapsed < 110) || (elapsed >= 210 && elapsed < 320);
      break;
    case FeedbackType::INVALID:
      sound = (elapsed < 180) || (elapsed >= 340 && elapsed < 520) ||
              (elapsed >= 680 && elapsed < 860);
      break;
  }
  digitalWrite(BUZZER_PIN, sound ? BUZZER_ON_LEVEL : !BUZZER_ON_LEVEL);
}

// Prueba autonoma al encender: NO requiere celular ni BLE.
// Esta rutina es solo de diagnostico. Despues continua el firmware original.
void hardwareSelfTest() {
  if (!ENABLE_RGB_LED && !ENABLE_BUZZER) {
    Serial.println("# Actuadores DESHABILITADOS: omitiendo autoprueba RGB/buzzer");
    return;
  }
  Serial.println("=== AUTOPRUEBA DE ACTUADORES EXTERNOS ===");
  if (ENABLE_RGB_LED) {
    Serial.printf("ROJO - GPIO%u\n", LED_R);
    setRgb(true, false, false); delay(900);
    Serial.printf("VERDE - GPIO%u\n", LED_G);
    setRgb(false, true, false); delay(900);
    Serial.printf("AZUL - GPIO%u\n", LED_B);
    setRgb(false, false, true); delay(900);
    Serial.printf("AMARILLO - GPIO%u + GPIO%u\n", LED_R, LED_G);
    setRgb(true, true, false); delay(900);
    setRgb(false, false, false);
  }
  if (ENABLE_BUZZER) {
    Serial.printf("BUZZER - GPIO%u por 3 segundos\n", BUZZER_PIN);
    digitalWrite(BUZZER_PIN, BUZZER_ON_LEVEL);
    delay(3000);
    digitalWrite(BUZZER_PIN, !BUZZER_ON_LEVEL);
  }
  Serial.println("=== FIN AUTOPRUEBA ===");
}

